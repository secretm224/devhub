<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.secretminc.devhub.domain.blogs.mapper.BlogMapper">

    <select id="findById" resultType="com.secretminc.devhub.domain.blogs.Blog">
        SELECT *
        FROM blog
        WHERE blog_id = #{blogId}
    </select>

</mapper>
